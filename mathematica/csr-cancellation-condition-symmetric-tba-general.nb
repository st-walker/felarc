Cell[TextData[{
 "Let\[CloseCurlyQuote]s quickly verify that the solutions given by ",
 Cell[BoxData[
  FormBox["m21Branches", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c148ab0-d36f-4ddf-9252-43522dff5794"],
