Cell[TextData[{
 "Global Assumptions.  One might reasonably wish to assert that the lengths \
are positive, rather than simply non-zero, however this  explodes the \
computation time later for solving some very simple equations, so I keep the \
assumptions based on equivalence rather than ordering.   With that said, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Theta]", "o"], " ", "and", " ", 
     SubscriptBox["\[Theta]", "i"], " ", "are", " ", "both", " ", "non"}], 
    "-", "zero"}], TraditionalForm]],ExpressionUUID->
  "d711b440-0624-48a3-9923-154ec73bf126"],
 ", magnet lengths ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "i"], TraditionalForm]],ExpressionUUID->
  "7b979e1a-7307-43b6-adf3-5c2ce5d43565"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "o"], TraditionalForm]],ExpressionUUID->
  "db040046-29e0-4bfd-a4a3-a65235bed54e"],
 "are non-zero and the combined CSR-dispersion kick components ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "o"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebceefda-078d-4c2f-9976-0749920f2b81"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08933cb9-ba98-42b7-9ec9-8da71bba5636"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "1"], ",", " ", 
    RowBox[{
     SubscriptBox["q", "2"], "and", " ", 
     SubscriptBox["q", "3"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7f1ad05-a259-43f7-93d3-00101a66e064"],
 " are all non-zero."
}], "Text",
 CellChangeTimes->{{3.9869713097092657`*^9, 3.986971317030105*^9}, {
  3.9869713821531057`*^9, 3.986971478064451*^9}, {3.9869749480787582`*^9, 
  3.986974948788224*^9}, {3.987130148919979*^9, 
  3.9871303659441023`*^9}},ExpressionUUID->"74df5e08-ae8e-4206-b236-\
c484f6aa171d"],

