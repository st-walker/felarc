Cell[TextData[{
 "Now convert the above equation into a list of equations.  We also take the \
numerator, in which we are implicitly assuming the denominators \[NotEqual] \
0, which in this case would mean ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "21"], "!=", "0"}], TraditionalForm]],ExpressionUUID->
  "fd9859e8-1a83-4524-977a-30324d296d8d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "o"], "!=", "0"}], TraditionalForm]],
  ExpressionUUID->"b34fc600-5f3e-4764-8af2-4d1368eacebb"],
 ", which are reasonable.  We saw above that for a TBA, the achromatic \
condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "12"], "\[Proportional]", 
    FractionBox["1", 
     RowBox[{
      SubscriptBox["\[Theta]", "o"], 
      SubscriptBox["m", "21"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "021311c5-0b70-479c-9fe7-95d9d608bb05"],
 ", which also diverges, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "21"], "!=", " ", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6654a01d-842f-40b4-8698-6c1dc1438139"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "o"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21887841-8f0a-458d-a79a-09fedbdef82c"],
 " are necessary.  x3Simplified is a vector equation still and we want to \
convert it simply to two equations, which is simply all the the Flatten, \
Thread, \[LeftDoubleBracket]...\[RightDoubleBracket] stuff is doing, i.e. \
converting a vector equation into a list of two equations."
}], "Text",
 CellChangeTimes->{{3.9868940028454103`*^9, 3.986894005927321*^9}, {
  3.986894435782316*^9, 3.986894514270514*^9}, {3.986961268318433*^9, 
  3.986961291678583*^9}, {3.986971162249385*^9, 3.986971162269709*^9}, {
