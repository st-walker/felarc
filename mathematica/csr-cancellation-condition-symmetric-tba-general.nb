Cell[TextData[{
 "We introduce these ratio rules as they vastly simply the final result.  \
They are simply the ratios of the inner dipole properties to the outer dipole \
properties, i.e. lengths and angles.  \[Lambda] = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["L", "i"], 
    SubscriptBox["L", "o"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85bdf2bc-d4db-4672-987a-bbceb09b23c8"],
 " and \[Tau] = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["\[Theta]", "i"], 
    SubscriptBox["\[Theta]", "o"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c017d96-948e-441b-9184-236297f8300c"],
 "."
}], "Text",
