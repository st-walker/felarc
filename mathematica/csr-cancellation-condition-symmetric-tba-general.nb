Cell[TextData[{
 "We now just get the numerator, as we know that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["m", "21"], 
     SubscriptBox["\[Theta]", "o"]}], "!=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6bbf1f0-a497-4bdf-b15c-6f83912a0b91"],
 " by design according to the achromatic condition we have already applied."
}], "Text",
