   RowBox[{
    RowBox[{
     RowBox[{"Wc2c", ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Mc2c", ".", "k1"}], "+", "k2"}], ")"}]}], " ", "+", " ", 
     "k3"}], " ", "==", " ", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0"},
       {"0"}
      }], "\[NoBreak]", ")"}]}]}], ";", " ", 
  RowBox[{"x3", "//", "  ", "TraditionalForm"}]}]], "Input",
