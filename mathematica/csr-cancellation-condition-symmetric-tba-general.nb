  FormBox[
   SubscriptBox["W", "c2c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8af794b5-fb8b-4d54-8c2e-e7550a5109e4"],
 "matrices to  ",
