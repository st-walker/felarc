Cell[TextData[{
 "Now we calculate the net kick, transporting the combined CSR-dispersion \
kick ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "1"], TraditionalForm]],ExpressionUUID->
  "0e5f89d0-c1e7-4501-8f9d-715974c3d4be"],
 "at the centre of the first dipole to the centre of the second dipole with \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "c2c"], TraditionalForm]],ExpressionUUID->
  "bb7dc557-f5bb-4ee1-bca8-be100587bfa0"],
 ", adding the combined CSR-dispersion kick of the middle dipole, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "2"], TraditionalForm]],ExpressionUUID->
  "0cd9bf80-a3dd-462d-b5b4-07409b773704"],
 ", transporting this combined effect using the mirror-symmetric matrix of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "c2c"], TraditionalForm]],ExpressionUUID->
  "1df97db2-4e7d-43e8-bc64-287e6bc0bcec"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "c2c"], TraditionalForm]],ExpressionUUID->
  "613bbb2c-723c-4f68-a91a-a84af1f5318f"],
 "to the centre of the final dipole, and incrementing the third combined \
CSR-dispersion kick, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "3"], TraditionalForm]],ExpressionUUID->
  "f003f8f8-1585-4e11-88ea-66bcda80785e"],
 ". We preemptively set ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "5a06c71e-7b65-4b96-9b21-9a836e565555"],
 "to 0 as we know we want the combined CSR-dispersion kick to cancel \
completely, ideally."
}], "Text",
 CellChangeTimes->{{3.9868914098299227`*^9, 3.986891410312244*^9}, {
   3.986891715967751*^9, 3.98689183454996*^9}, {3.986892186309128*^9, 
   3.9868922148067207`*^9}, 3.986893492009109*^9, {3.986971162095851*^9, 
   3.986971162150721*^9}},ExpressionUUID->"0a2f27f5-2279-4da9-8438-\
9b7d8c35ba6d"],

