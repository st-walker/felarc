  FormBox[
   SubscriptBox["X", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fda9272-a5ca-4696-adf1-170fe8e6c54f"],
 "to (0, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"0", ")"}], 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2380615-06c7-469b-ad15-48737869c93d"],
 ", as required."
}], "Text",
