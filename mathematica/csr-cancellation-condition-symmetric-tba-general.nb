Cell[TextData[{
 "Define the half-magnet 2\[Cross]2 small-angle approximation matrices.  They \
are just drifts in effect with this approximation and in 2D.  The matrices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "c2c"], TraditionalForm]],ExpressionUUID->
  "d8527a0d-b218-4e39-adf5-01622d22f0b2"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "c2c"], TraditionalForm]],ExpressionUUID->
  "daf475af-333d-4f1b-9d80-fcad2c53ff9f"],
 "the beam transport matrices from the centre of the first dipole to the \
centre of the second dipole, and from the centre of the second dipole, to the \
third dipole, respectively.   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "c2c"], TraditionalForm]],ExpressionUUID->
  "0b948c94-fa8b-4275-9aed-eac4d3b7e327"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "c2c"], TraditionalForm]],ExpressionUUID->
  "01a0a5a6-c903-488d-be67-93055f3c966d"],
 "are at this stage unknown and expressed in terms of A, B, C, and D matrix \
elements.  We also define the combined CSR-dispersion point-kicks ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "1"], TraditionalForm]],ExpressionUUID->
  "e594bf8c-281c-4fb3-871b-ffbddcdd5015"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "2"], TraditionalForm]],ExpressionUUID->
  "1c5ff621-565a-48de-9ddf-915c10c2473c"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "3"], TraditionalForm]],ExpressionUUID->
  "675a1eb8-515b-47b2-8c09-6aab6a07c860"],
 " in terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "o"], TraditionalForm]],ExpressionUUID->
  "6d9fdaa8-08da-4b48-a605-7f69fea9df00"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "07dc373f-27cc-4b27-81b5-1944ecea27be"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["q", "j"], "for", " ", "j"}], "\[Element]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"37062891-0989-4ea2-b14c-bfa3c85b20bf"],
 ".  See qFull, and pFull functions above for their full, expanded forms.  \
However, we will only substitute these full forms in at the very end of the \
derivation in order to keep things simple."
}], "Text",
 CellChangeTimes->{{3.986888364824979*^9, 3.986888392288241*^9}, {
  3.98689135429471*^9, 3.9868914018370667`*^9}, {3.986893226383616*^9, 
