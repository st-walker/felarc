Cell[TextData[{
 "We need to find the condition under which the two components of the vector \
equation are mutually solvable.  So use Eliminate to remove eliminate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "21"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d4e3c2a-bdb2-45a5-8f38-58f29ae2e82d"],
 "from the two equations and this gives us a relation between ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "1"], ",", " ", 
    SubscriptBox["q", "2"], ",", " ", 
    SubscriptBox["q", "3"], ",", 
    RowBox[{
     SubscriptBox["\[Theta]", "o"], "and", " ", 
     SubscriptBox["\[Theta]", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce9fb2d9-9e2c-4d78-a0f9-9b3a770eae33"],
 ".  This is not necessary for the case with all three dipoles being \
perfectly equal, as the condition below is automatically true in that case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["q", "1"], "==", 
     SubscriptBox["q", "2"], "==", 
     SubscriptBox["q", "3"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3111b51c-eb4c-4f19-9f5b-8544a6e2794f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "o"], "==", 
    SubscriptBox["\[Theta]", "i"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "741fcfe6-8a0f-41a1-b75c-3b55b823e955"],
 ")."
}], "Text",
 CellChangeTimes->{{3.987064812905184*^9, 3.987064817057816*^9}, 
   3.987065187103904*^9, {3.9871308042927923`*^9, 3.9871308063682003`*^9}, {
