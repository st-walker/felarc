    Rational[4, 3] ($CellContext`\[Theta]o 
     Cos[Rational[1, 2] $CellContext`\[Theta]o] - 2 
    Sin[Rational[1, 2] $CellContext`\[Theta]o])],
  Editable->False]], "Print",
