Cell[BoxData[
 RowBox[{"eqs", "=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"x3simplified", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", 
    RowBox[{"Flatten", "[", 
     RowBox[{"x3simplified", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}]], "Input",
